@model Leave__Management_System.Models.LeaveAllocations.AllocationEditViewModel

<div class="modal-header">
    <h5 class="modal-title">Edit Allocation - @Model.LeaveTypeName</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
    <form asp-action="EditAllocation" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="EmployeeId" />
        <input type="hidden" asp-for="LeaveTypeId" />
        <input type="hidden" asp-for="PeriodId" />

        <div class="mb-3">
            <label asp-for="NumberOfDays" class="form-label"></label>
            <input asp-for="NumberOfDays" class="form-control" />
            <span asp-validation-for="NumberOfDays" class="text-danger d-block mt-1"></span>
        </div>

        <div class="mb-3">
            <label asp-for="RemainingDays" class="form-label"></label>
            <input asp-for="RemainingDays" class="form-control" />
            <span asp-validation-for="RemainingDays" class="text-danger d-block mt-1"></span>
        </div>
    </form>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
    <button type="button" class="btn btn-primary" onclick="$('#globalModal form').submit();">Save</button>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
