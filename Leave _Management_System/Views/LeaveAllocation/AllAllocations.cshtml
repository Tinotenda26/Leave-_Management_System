@model List<Leave__Management_System.Models.LeaveAllocations.AllocationEditViewModel>

@{
    ViewData["Title"] = "Manage All Allocations";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="h3">Manage Leave Allocations</h2>
            <p class="text-muted">View and override employee leave allocations</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filter Section -->
    <div class="row mb-4">
        <div class="col-md-6">
            <form asp-action="AllAllocations" method="get" class="d-flex gap-2">
                <input type="text" name="employeeFilter" class="form-control" placeholder="Search by name or email..."
                       value="@ViewData["EmployeeFilter"]" />
                <button type="submit" class="btn btn-primary">Search</button>
                <a asp-action="AllAllocations" class="btn btn-secondary">Clear</a>
            </form>
        </div>
    </div>

    <!-- Allocations Table -->
    @if (Model != null && Model.Any())
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover table-borderless align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Employee</th>
                            <th>Leave Type</th>
                            <th>Period</th>
                            <th class="text-center">Original Days</th>
                            <th class="text-center">Remaining Days</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@item.EmployeeName</strong><br />
                                    <small class="text-muted">@item.EmployeeId</small>
                                </td>
                                <td>@item.LeaveTypeName</td>
                                <td>
                                    @item.PeriodName<br />
                                    <small class="text-muted">@item.PeriodStart.ToString("yyyy-MM-dd") - @item.PeriodEnd.ToString("yyyy-MM-dd")</small>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-primary">@item.NumberOfDays</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-success">@item.RemainingDays</span>
                                </td>
                                <td class="text-end">
                                    <a asp-controller="LeaveAllocation" asp-action="EditAllocation" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary open-edit-modal">Edit</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <h5 class="mb-0">No allocations found</h5>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
