@model Leave__Management_System.Models.LeaveTypes.LeaveTypeCreateVM

@{
    ViewData["Title"] = "Create";
}

<h1>Create Leave Type</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Name" class="control-label font-weight-bold"></label>
                <input asp-for="Name" class="form-control" placeholder="Enter leave type name" minlength="4" maxlength="150" id="NameInput" />
                <small class="form-text text-muted d-block mt-1">
                    <span id="charCount">0</span>/150 characters
                </small>
                <span asp-validation-for="Name" class="text-danger d-block mt-1"></span>
            </div>
            <br/>
            <div class="form-group">
                <label asp-for="NumberOfDays" class="control-label font-weight-bold"></label>
                <input asp-for="NumberOfDays" class="form-control" placeholder="Enter number of days" />
                <span asp-validation-for="NumberOfDays" class="text-danger d-block mt-1"></span>
            </div>
            <br/>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-success" />
                <a asp-action="Index"class="btn btn-primary">Back to List</a>
            </div>
        </form>
    </div>
</div>



@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function() {
            var nameInput = $('#NameInput');
            var charCount = $('#charCount');
            var nameValidation = nameInput.next('small').next('span');

            // Auto-hide validation messages after 10 seconds
            function autoHideValidationMessages() {
                var validationSpans = $('span.text-danger');
                validationSpans.each(function() {
                    var $span = $(this);
                    if ($span.text().trim() !== '') {
                        setTimeout(function() {
                            $span.fadeOut(300);
                        }, 10000);
                    }
                });
            }

            // Update character count on input
            nameInput.on('input', function() {
                var length = $(this).val().length;
                charCount.text(length);

                // Show character requirement message if less than 4 characters
                if (length === 0) {
                    // Keep validation message display
                } else if (length < 4) {
                    var remaining = 4 - length;
                    nameValidation.text('Minimum ' + remaining + ' more character' + (remaining === 1 ? '' : 's') + ' required');
                    nameValidation.show();
                } else {
                    nameValidation.text('');
                    nameValidation.hide();
                }
            });

            // Initialize on page load
            nameInput.trigger('input');

            // Auto-hide validation messages on page load
            autoHideValidationMessages();
        });
    </script>
}

