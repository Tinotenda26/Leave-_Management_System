<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Leave Management System</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Leave__Management_System.styles.css" asp-append-version="true" />

    <!-- FullCalendar CSS -->
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.14/index.global.min.css" rel="stylesheet" />
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark bg-primary">

<div class="container">

<a class="navbar-brand" asp-controller="Home" asp-action="Index">



Leave Management

</a>

<button class="navbar-toggler"
type="button"
data-bs-toggle="collapse"
data-bs-target="#navbar">

<span class="navbar-toggler-icon"></span>

</button>

<div class="collapse navbar-collapse" id="navbar">

<ul class="navbar-nav ms-auto">

<li class="nav-item">
  <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
</li>

<li class="nav-item">
  <a class="nav-link" asp-controller="Home" asp-action="About">About</a>
</li>

<li class="nav-item">
  <a class="nav-link" asp-controller="Home" asp-action="Contact">Contact</a>
</li>

<partial name="_LoginPartial" />
</ul>
</div>
</div>
</nav>
 
    <div class="container layout-container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>


    <footer class="border-bottom footer text-light bg-dark">
        <div class="container">
            &copy; 2026 - Leave Management System - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Global modal for AJAX edit forms -->
    <div class="modal fade" id="globalModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <!-- content loaded via AJAX -->
            </div>
        </div>
    </div>

    <script>
        $(function() {
            // Delegate click for dynamic links
            $(document).on('click', '.open-edit-modal', function (e) {
                e.preventDefault();
                var url = $(this).attr('href');
                if (!url) return;
                // load partial view
                $.get(url)
                    .done(function (html) {
                        $('#globalModal .modal-content').html(html);
                        var modal = new bootstrap.Modal(document.getElementById('globalModal'));
                        modal.show();
                    })
                    .fail(function () {
                        alert('Failed to load form.');
                    });
            });

            // Intercept form submits inside modal and POST via AJAX
            $(document).on('submit', '#globalModal form', function (e) {
                e.preventDefault();
                var form = $(this);
                var url = form.attr('action') || window.location.href;
                var data = form.serialize();

                $.post(url, data)
                    .done(function (response) {
                        // If JSON success, close modal and reload
                        if (response && response.success) {
                            var modalEl = document.getElementById('globalModal');
                            var modal = bootstrap.Modal.getInstance(modalEl);
                            if (modal) modal.hide();
                            location.reload();
                            return;
                        }

                        // If it's HTML (partial view with validation errors), replace modal content
                        if (typeof response === 'string') {
                            $('#globalModal .modal-content').html(response);
                        }
                    })
                    .fail(function () {
                        alert('Failed to save.');
                    });
            });

            // Intercept employee cancel forms and show SweetAlert2 confirmation
            $(document).on('submit', '.cancel-request-form', function (e) {
                e.preventDefault();
                var form = $(this);
                Swal.fire({
                    title: 'Cancel leave request?',
                    text: 'Are you sure you want to cancel this leave request? The days will be refunded.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, cancel it',
                    cancelButtonText: 'No, keep it'
                }).then(function(result) {
                    if (result.isConfirmed) {
                        var url = form.attr('action') || window.location.href;
                        var data = form.serialize();
                        $.post(url, data)
                            .done(function () {
                                Swal.fire('Cancelled', 'Your leave request has been cancelled.', 'success').then(function(){ location.reload(); });
                            })
                            .fail(function () {
                                Swal.fire('Error', 'Failed to cancel the request.', 'error');
                            });
                    }
                });
            });

            // Intercept confirm delete forms and show SweetAlert2 confirmation
            $(document).on('submit', '.confirm-delete-form', function (e) {
                e.preventDefault();
                var form = $(this);
                Swal.fire({
                    title: 'Confirm deletion',
                    text: 'Are you sure you want to permanently delete this item? This action cannot be undone.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, delete it',
                    cancelButtonText: 'No, keep it'
                }).then(function(result) {
                    if (result.isConfirmed) {
                        var url = form.attr('action') || window.location.href;
                        var data = form.serialize();
                        $.post(url, data)
                            .done(function () {
                                Swal.fire('Deleted', 'The item was deleted successfully.', 'success').then(function(){ location.reload(); });
                            })
                            .fail(function () {
                                Swal.fire('Error', 'Failed to delete the item.', 'error');
                            });
                    }
                });
            });
        });
    </script>

    <!-- FullCalendar Script -->
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.14/index.global.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
