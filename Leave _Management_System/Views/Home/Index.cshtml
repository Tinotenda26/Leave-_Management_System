@{
    ViewData["Title"] = "Home Page";
}

<div class="container py-5">
    <div class="text-center mb-4">
        <h1 class="display-4">Welcome to Leave Management System</h1>
        <p class="text-muted">Use the links below to navigate the application.</p>
    </div>

    <div class="row g-3">
        @if (User.IsInRole("Supervisor"))
        {
            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">Employees</h5>
                        <p class="card-text text-muted">View and manage employees.</p>
                        <div class="mt-auto">
                            <a asp-controller="Employees" asp-action="Index" class="btn btn-outline-secondary me-2">List</a>
                            <a asp-controller="Employees" asp-action="Create" class="btn btn-outline-secondary">Add</a>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Leave Management</h5>
                    <p class="card-text text-muted">Leave types, periods and allocations.</p>
                    <div class="mt-auto">
                        <a asp-controller="Periods" asp-action="Index" class="btn btn-outline-secondary me-2">Periods</a>
                        @if (User.IsInRole("Supervisor"))
                        {
                            <a asp-controller="LeaveTypes" asp-action="Index" class="btn btn-outline-secondary me-2">Leave Types</a>
                            <a asp-controller="LeaveAllocation" asp-action="Index" class="btn btn-warning me-2">All Allocations</a>
                           
                        }
                        else if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <a asp-controller="LeaveAllocation" asp-action="Details" class="btn btn-outline-secondary">My Allocations</a>
                        }
                        else
                        {
                            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary">Login to view</a>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Requests</h5>
                    <p class="card-text text-muted">Create or review leave requests.</p>
                    <div class="mt-auto">
                        @if (User.IsInRole("Supervisor"))
                        {
                            <a asp-controller="LeaveRequests" asp-action="Review" class="btn btn-primary">Review Requests</a>
                        }
                        else if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <a asp-controller="LeaveAllocation" asp-action="Details" class="btn btn-primary">Request Leave</a>
                        }
                        else
                        {
                            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-primary">Login to request</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
